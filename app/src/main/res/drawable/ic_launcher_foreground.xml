<?xml version="1.0" encoding="utf-8"?>
<!--
  MotionFlow launcher icon foreground.

  The mark is a monoline "M" whose strokes are drawn as a single continuous ribbon with round caps
  and joins, so the letter reads as one flowing gesture rather than as a block glyph. The white to
  cyan gradient travels along the stroke direction: white at the entry, accent cyan at the exit,
  which is the visual shorthand for a frame moving from one state to the next.

  Geometry lives inside the adaptive icon safe zone (the central 66dp of the 108dp canvas), so no
  part of the mark is clipped by round, squircle or teardrop masks.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M34,71 L34,37 L54,59 L74,37 L74,71"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="34"
                android:startY="37"
                android:endX="74"
                android:endY="71">
                <item
                    android:offset="0"
                    android:color="#FFFFFFFF" />
                <item
                    android:offset="1"
                    android:color="#FF45D4FF" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
